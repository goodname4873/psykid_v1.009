# ═══════════════════════════════════════════════════════════════
# 树洞 AI 心理咨询平台 v1.009 · 环境配置模板
# 复制此文件为 .env 并填入你的 API Key
# ═══════════════════════════════════════════════════════════════

# ─── 服务器与鉴权 ───
PORT=3000
HOST=localhost
JWT_SECRET=替换为随机字符串（如 openssl rand -hex 32）
JWT_EXPIRES_IN=7d

# ─── 数据库 ───
DB_PATH=./data/psy_consult.db

# ═══════════════════════════════════════════
# 主管道 LLM (DashScope 阿里百炼)
# 申请地址: https://bailian.console.aliyun.com/
# ═══════════════════════════════════════════
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=你的DashScope_API_Key
AI_MODEL=qwen3.6-plus
COORDINATOR_MODEL=qwen3.5-flash
THREAD_MODEL=qwen3.5-flash
PROFILE_MODEL=qwen3.5-flash
SCHEDULER_MODEL=qwen3.5-flash

# ═══════════════════════════════════════════
# Guardian 守护进程 LLM (独立 DashScope 第二账号，可选)
# 与主管道共用同一账号也可以，但建议用独立账号避免RPM争抢
# ═══════════════════════════════════════════
GUARDIAN_API_KEY=你的Guardian_API_Key（可与上面相同）
GUARDIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GUARDIAN_ANALYZER_MODEL=qwen3.6-plus
GUARDIAN_GENERATOR_MODEL=qwen3.6-plus
GUARDIAN_MATCHER_MODEL=qwen3.5-flash

# ═══════════════════════════════════════════
# 语音 ASR + TTS (DashScope)
# ═══════════════════════════════════════════
DASHSCOPE_API_KEY=你的DashScope_API_Key（可与AI_API_KEY相同）
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_TTS_VOICE=Cherry

# ═══════════════════════════════════════════
# Expert 专家审视 (DeepSeek V4 Pro 跨家族验证)
# 申请地址: https://platform.deepseek.com/
# ═══════════════════════════════════════════
REVIEW_API_BASE=https://api.deepseek.com
REVIEW_API_KEY=你的DeepSeek_API_Key
REVIEW_MODEL=deepseek-v4-pro

# ═══════════════════════════════════════════
# 网络代理设置 (DashScope 走直连，不要走 VPN)
# ═══════════════════════════════════════════
NO_PROXY=dashscope.aliyuncs.com,*.aliyuncs.com

# ─── 文件上传 ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=25000000

# ─── HTTPS (移动端可选) ───
HTTPS_PORT=3001
